{
  "name": "md-editor",
  "productName": "MD",
  "version": "0.1.0",
  "private": true,
  "description": "MD — a tabbed Markdown editor for Windows (see PLAN.md)",
  "keywords": [
    "markdown",
    "editor",
    "electron"
  ],
  "license": "MIT",
  "author": {
    "name": "Giancarlo Guevarra",
    "email": "guevarra1006@gmail.com"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:logo": "node tools/build-logo.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@fontsource/eb-garamond": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "electron": "44.8.0",
    "jsdom": "^30.1.3",
    "opentype.js": "^2.0.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.88.0",
    "png-to-ico": "^3.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@lezer/highlight": "^1.2.5",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron-squirrel-startup": "^1.0.1",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "update-electron-app": "^3.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GianniGuava/md-editor.git"
  },
  "homepage": "https://github.com/GianniGuava/md-editor",
  "optionalDependencies": {
    "@oxlint/binding-win32-x64-msvc": "^1.88.0",
    "@oxlint/win32-x64-msvc": "npm:null@*"
  }
}
