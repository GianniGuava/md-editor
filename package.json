{
  "name": "md-editor",
  "productName": "MD",
  "version": "0.1.0",
  "private": true,
  "description": "MD — a tabbed Markdown editor for Windows (see PLAN.md)",
  "keywords": [
    "markdown",
    "editor",
    "electron"
  ],
  "license": "MIT",
  "author": {
    "name": "Giancarlo Guevarra",
    "email": "guevarra1006@gmail.com"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/markdown-it": "^14.2.0",
    "electron": "44.8.0",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.88.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron-squirrel-startup": "^1.0.1",
    "markdown-it": "^15.0.3"
  }
}
