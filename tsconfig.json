{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "web/**/*", "*.ts", "*.mts", "e2e/**/*"],
  "exclude": ["web/dist"]
}
